# Copiar para .env.local (local) ou configurar na Vercel > Settings > Environment Variables

# URL público do site
NEXT_PUBLIC_SITE_URL=https://pequenomundomagico.pt

# Supabase (painel administrativo e catálogo). Sem isto, o site usa os produtos de data/seed.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dados legais do vendedor (aparecem no rodapé e nas páginas legais)
NEXT_PUBLIC_SELLER_NAME=
NEXT_PUBLIC_SELLER_NIF=
NEXT_PUBLIC_SELLER_ADDRESS=
NEXT_PUBLIC_SELLER_EMAIL=

# Só para o modo sem Supabase: link de checkout da Kiwify do livro Luna
KIWIFY_URL_LUNA=
